# ============================================================
# AuditCore — environment template
# Copy to .env and fill in. setup.sh generates random values for
# SECRET_KEY and ENCRYPTION_MASTER_KEY.
# ============================================================

# ---- Supabase Postgres (your external project) ----
# Project ref: zqcvwxaiblovwkjvcqmz (ap-southeast-2)
SUPABASE_DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.zqcvwxaiblovwkjvcqmz
SUPABASE_DB_PASSWORD=replace-me-with-the-real-password

# ---- Supabase Auth (same project) ----
# URL: Project Settings → API → Project URL
# JWT secret: Project Settings → API → JWT Settings → JWT Secret
# Service role: Project Settings → API → service_role key (SECRET; seed-only)
SUPABASE_URL=https://zqcvwxaiblovwkjvcqmz.supabase.co
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
# Anon/publishable key — used by the backend /auth/login rate-limit proxy.
SUPABASE_ANON_KEY=paste-your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# ---- Deployment ----
# Set to "production" on live deployments. In production the backend REFUSES to
# start if the DB role can bypass RLS (see SECURITY.md). ALLOW_RLS_BYPASS is an
# explicit escape hatch (keep false in real tenants).
ENVIRONMENT=development
ALLOW_RLS_BYPASS=false

# ---- App crypto ----
SECRET_KEY=replace-me-32-random-bytes

# ---- File storage / encryption ----
STORAGE_ROOT=/data
ENCRYPTION_MASTER_KEY=replace-me-32-random-bytes

# ---- WhatsApp bridge auth ----
# Shared secret the backend sends as X-Bridge-Token to the Baileys bridge.
# MUST be identical on both sides. setup.sh/install.sh auto-generate this.
WHATSAPP_BRIDGE_TOKEN=replace-me-32-random-bytes

# ---- Auth hardening ----
# Token denylist behaviour when Redis is unreachable. false (default) = fail
# open (token allowed); true = fail closed (request rejected with 503). See
# SECURITY.md for the tradeoff. Keep false unless you run highly-available Redis.
TOKEN_DENYLIST_FAIL_CLOSED=false

# ---- Frontend (read by Vite at build time) ----
VITE_AUDITCORE_SUPABASE_URL=https://zqcvwxaiblovwkjvcqmz.supabase.co
VITE_AUDITCORE_SUPABASE_ANON_KEY=paste-your-anon-key-here
VITE_AUDITCORE_API_URL=http://localhost:8000
