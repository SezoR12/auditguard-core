# ============================================================
# AuditCore — environment template
# Copy to .env and fill in. setup.sh generates random values for
# SECRET_KEY, JWT_SECRET, and SUPABASE_DB_PASSWORD prompts.
# ============================================================

# ---- Supabase Postgres (your external project) ----
# Project ref: zqcvwxaiblovwkjvcqmz (ap-southeast-2)
SUPABASE_DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.zqcvwxaiblovwkjvcqmz
SUPABASE_DB_PASSWORD=replace-me-with-the-real-password

# ---- JWT / Crypto ----
SECRET_KEY=replace-me-32-random-bytes
JWT_SECRET=replace-me-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Frontend (read by Vite at build time) ----
VITE_AUDITCORE_SUPABASE_URL=https://zqcvwxaiblovwkjvcqmz.supabase.co
VITE_AUDITCORE_SUPABASE_ANON_KEY=paste-your-anon-key-here
VITE_AUDITCORE_API_URL=http://localhost:8000
